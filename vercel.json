{
    "version": 2,
    "builds": [
        {
            "src": "*.php",
            "use": "vercel-php@0.7.4"
        }
    ],
    "routes": [
        {
            "src": "/styles.css",
            "dest": "/styles.css"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}
